GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase — get these from: https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Direct Postgres connection string (Settings → Database → Connection string → "Direct connection",
# port 5432, NOT the pooler). Required by the migration runner (python -m db.migrate); unused by the
# app runtime, which goes through PostgREST.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# Staging's migration ledger, read-only, by the promotion runner (python -m promotion, #516)
# so it can refuse to run DDL on production that staging has never run. Optional locally and
# in the app runtime; SESSION-mode pooler URI (port 5432, user postgres.<ref>) for the STAGING
# project — staging is on the aws-1-us-west-2 cluster. When unset, the promotion runner cannot
# tell "staging ran nothing" from "couldn't check" and blocks once with a clear message rather
# than guessing; pass --skip-staging-check to proceed deliberately without this guard.
# STAGING_SUPABASE_DB_URL=postgresql://postgres.[staging-ref]:[password]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Logfire ops/error/LLM tracing (optional). Get a write token from
# https://logfire.pydantic.dev → your project → Settings → Write tokens.
# When unset, Logfire stays dormant: the app behaves exactly as today with no
# egress. When set, FastAPI request traces and Pydantic AI agent spans (incl.
# per-call LLM token usage) stream to Logfire. Prompt/completion/document text
# is scrubbed to a length-capped preview + sha256 fingerprint before egress
# (services/logfire_scrubber.py); request bodies/headers are never captured.
# LOGFIRE_TOKEN=

# Deployment environment. Defaults to "production" when unset (strict, fail-closed checks).
# Set APP_ENV=local for local dev (relaxes SESSION_SECRET); set APP_ENV=staging on the staging
# deploy (drives the noindex header). "staging" is NOT in IS_LOCAL, so it stays fail-closed.
APP_ENV=production

# Column-level encryption (AES-256-GCM). 32 bytes as 64 hex chars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# OCR pipeline
# OCR_ENGINE: "docling" (default, layout-aware), "auto" (Docling + GOT-OCR fallback for math), "tesseract" (legacy)
OCR_ENGINE=docling

# REDIS_URL: optional cross-worker cache (#97). Unset = disabled (default).
# When set, OCR/extraction results are cached content-addressed. e.g. redis://localhost:6379/0
# REDIS_URL=
# GOT_OCR_ENABLED: gates loading of GOT-OCR 2.0 weights. Requires GPU in practice; keep false on CPU-only deployments.
GOT_OCR_ENABLED=false
# HuggingFace repo id or local path for GOT-OCR 2.0 weights. Note: model uses trust_remote_code=True.
GOT_OCR_MODEL_PATH=stepfun-ai/GOT-OCR2_0
# GEMINI_VISION_OCR_ENABLED: transcribe pages that have no text layer (scans,
# photographed handwriting) with Gemini vision. Unlike GOT_OCR it needs no
# weights and no GPU, and it handles handwritten mathematics. Costs one LLM call
# per flagged page — pages with a normal text layer are never flagged, so a
# text PDF costs nothing. Off by default because that spend should be opted into.
# Without this (or GOT_OCR), a scanned upload extracts to "" and is NOT rejected:
# the upload path only converts extraction *exceptions* into a 422, so the empty
# string flows into the classify prompt and the model invents a summary and
# concepts for a document it never read. (The rejection is PR #419, still open.)
GEMINI_VISION_OCR_ENABLED=false
# GEMINI_VISION_OCR_MAX_PAGES: per-document ceiling on those metered calls.
# Nothing upstream bounds how many pages one document can flag — /api/extract
# allows up to 50 and the upload path is not rate-limited at all — so the cap
# lives in the extractor. Pages past it keep whatever Docling extracted, and a
# warning names how many were skipped. 0 disables vision transcription entirely.
GEMINI_VISION_OCR_MAX_PAGES=10
# The transcription model is the ADR-0008 per-task slot, not a knob of its own:
# SAPLING_MODEL_OCR_VISION=gemini-2.5-flash

# Quiz generation abuse guard (#544 F1; env-overridable since #537). The window
# lives in a process-local dict, so ONE Playwright run spends a single budget
# across every spec — the E2E lanes raise this; production keeps the default.
# Unparseable or non-positive values fall back to the default.
# QUIZ_GENERATE_RATE_LIMIT=8
# Sliding-window length for that limit, in seconds. E2E lanes raise the limit
# rather than shrink the window; production keeps the default.
# QUIZ_GENERATE_RATE_WINDOW_SEC=300

# Jev decision backend (learning loop PKG-15; spec §3.6, ADR 0031). OFF by default:
# with JEV_ENABLED unset or anything but "true", every decision is served by Gemini
# whatever DECISION_BACKEND_<NAME> says, and no Typesafe client is ever built (it is
# also never built under SAPLING_MODEL_MODE=function). PRIVACY GATE (spec §13 A24):
# leave it off wherever student traffic flows until the owner records the gate —
# a shadow sends the decision's text (a student's answer included) to Typesafe.
# JEV_ENABLED=false
# The A24 privacy gate's switch, in code: an ALLOWLIST (spec §13 A104). Only a local
# APP_ENV (local/development/dev/test, config.IS_LOCAL) is ungated; with ANY other value —
# production, staging, prod, preview, beta, unknown, unset — NO Jev call goes out (serve
# or shadow) until this is "true". Set it only
# once the owner has recorded the gate (HANDOFF-15 "Runbook: the privacy gate").
# JEV_PRIVACY_GATE_RECORDED=false
# The SDK's own env names (typesafe-sdk==0.7.2). The key is a secret; the base URL
# defaults to https://api.typesafe.ai.
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Per-decision backend: gemini (default) | jev | shadow_jev. jev serves
# match_wrong_reason / item_answerable / judge_leak (any Jev failure → Gemini);
# the grading decisions are never served from Jev (jev_unsupported) but can shadow.
# Nothing is promoted; promote per decision only after the §3.6 gates
# (python tests/evals/decisions.py --shadow-log ...).
# DECISION_BACKEND_MATCH_WRONG_REASON=shadow_jev
# DECISION_BACKEND_ITEM_ANSWERABLE=gemini
# DECISION_BACKEND_JUDGE_LEAK=gemini
# DECISION_BACKEND_GRADE_RUBRIC_ITEMS=gemini
# DECISION_BACKEND_REASON_IS_CORRECT=gemini
