// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GradescopeSyncDialog handlers > blocks dismissal while waiting for Duo, then reloads after approval 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Waiting for Duo approval</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div class="pt-2"><div class="flex gap-3.5 items-center mb-3.5"><div aria-hidden="true" class="w-7 h-7 rounded-[50%] border-3 border-border border-t-accent [animation:gs-spin_0.9s_linear_infinite] shrink-0"></div><div><div class="font-display font-medium text-xl text-text tracking-[-0.01em] mb-0.5">Approve the Duo push on your phone.</div><div class="mono text-xs text-text-muted tracking-[-0.01em]">Waiting · Ns</div></div></div><p class="font-serif text-md leading-[1.6] text-text-dim m-0">Sapling is signing in at shib.bu.edu now. The push usually arrives within a few seconds. We'll finish automatically once you tap Approve. Keep this window open.</p></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > keeps the ready stage on a sync failure that is not a sign-in problem 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Pull grades from Gradescope</h2></header><div role="alert" class="py-2.5 px-3 rounded-sm bg-err-soft text-err text-md mb-3.5 border border-[color-mix(in_oklab,_var(--err)_25%,_transparent)]">Upstream down.</div><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-4">Sapling will pull every assignment from Gradescope course <span class="mono text-text">123</span> and update grades in . New assignments are matched to categories by title where possible. You can re-categorize them after.</p><p class="mono text-xs text-text-muted tracking-[-0.01em] mt-0 mx-0 mb-4.5">Last sync · DATE</p><div class="flex justify-between gap-3 flex-wrap"><button type="button" class="btn btn--ghost">Change course</button><button type="button" class="btn btn--ghost">Use different account</button><div class="flex gap-2.5"><button type="button" class="btn">Close</button><button type="button" class="btn btn--primary">Sync now</button></div></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > bu-sso-form 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Sign in with BU SSO</h2></header><div class="flex-1 overflow-y-auto min-h-0"><form><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-4.5">Enter your BU login. Sapling drives a headless browser through <span class="mono text-text">shib.bu.edu</span> on your behalf. Your password is held in memory for the request only, never written to disk. When you submit, your phone will buzz with a Duo push; tap <strong class="text-text">Approve</strong>.</p><label for="X" class="mono block text-md text-text-muted mb-1.5">BU username</label><input id="X" required="" autocomplete="username" placeholder="e.g. jackhe" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text text-base mb-3.5" type="text" value=""><label for="X" class="mono block text-md text-text-muted mb-1.5">BU password</label><input id="X" required="" autocomplete="current-password" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text text-base mb-5" type="password" value=""><div class="flex gap-2.5 justify-between items-center"><button type="button" class="btn btn--ghost py-1.5 px-2.5 text-sm">← Back</button><button type="submit" class="btn btn--primary">Sign in &amp; send Duo push</button></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > choose-mode 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Connect Gradescope</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-4.5">Three ways to connect. Pick whichever matches how you sign in to Gradescope.</p><button type="button" class="w-full text-left py-3.5 px-4 border border-border rounded-md bg-bg-panel cursor-pointer [transition:border-color_var(--dur-fast)_var(--ease),_background-color_var(--dur-fast)_var(--ease)]"><div class="font-display font-medium text-[17px] text-text tracking-[-0.01em] mb-1">BU SSO + Duo</div><div class="font-serif text-md leading-[1.5] text-text-dim">If you sign in to Gradescope through BU. Enter your BU username and password here; tap Approve when your phone buzzes. Your BU password is used in-memory only. Sapling never writes it to disk. Only the resulting Gradescope session cookies are stored.</div></button><div class="h-3"></div><button type="button" class="w-full text-left py-3.5 px-4 border border-border rounded-md bg-bg-panel cursor-pointer [transition:border-color_var(--dur-fast)_var(--ease),_background-color_var(--dur-fast)_var(--ease)]"><div class="font-display font-medium text-[17px] text-text tracking-[-0.01em] mb-1">Email + password</div><div class="font-serif text-md leading-[1.5] text-text-dim">If you set a Gradescope-side password (no SSO). We sign in once and keep only the Gradescope session, never your password; enter it again when the session expires.</div></button><div class="h-3"></div><button type="button" class="w-full text-left py-3.5 px-4 border border-border rounded-md bg-bg-panel cursor-pointer [transition:border-color_var(--dur-fast)_var(--ease),_background-color_var(--dur-fast)_var(--ease)]"><div class="font-display font-medium text-[17px] text-text tracking-[-0.01em] mb-1">Session cookies (manual)</div><div class="font-serif text-md leading-[1.5] text-text-dim">If you'd rather paste session cookies yourself. Works for any school. Reconnect when the session expires or you sign out of Gradescope.</div></button><div class="flex justify-end mt-5"><button type="button" class="btn">Cancel</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > cookies 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Paste your Gradescope session</h2></header><div class="flex-1 overflow-y-auto min-h-0"><form><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-3">Sign in to Gradescope normally in another tab (BU SSO + Duo, whatever your school uses). Then copy these two cookie values out of DevTools.</p><ol class="font-serif text-md leading-[1.6] text-text-dim mt-0 mx-0 mb-4.5 pl-5"><li>With Gradescope open, press <kbd class="inline-block py-px px-1.5 border border-border [border-bottom-width:2px] rounded-xs font-sans text-xs bg-bg-subtle text-text">F12</kbd> (or right-click → Inspect).</li><li>Go to <strong class="text-text">Application</strong> → <strong class="text-text">Cookies</strong> → <span class="mono text-text">https://www.gradescope.com</span>.</li><li>Copy the <strong class="text-text">Value</strong> of <span class="mono">_gradescope_session</span> and, if present, <span class="mono">signed_token</span>.</li></ol><label for="X" class="mono block text-md text-text-muted mb-1.5">_gradescope_session <span class="text-err">*</span></label><textarea id="X" required="" rows="2" spellcheck="false" autocomplete="off" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text font-code text-sm resize-y mb-3.5"></textarea><label for="X" class="mono block text-md text-text-muted mb-1.5">signed_token <span class="text-text-muted">(optional)</span></label><textarea id="X" rows="2" spellcheck="false" autocomplete="off" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text font-code text-sm resize-y mb-5"></textarea><div class="flex gap-2.5 justify-between items-center"><button type="button" class="btn btn--ghost py-1.5 px-2.5 text-sm">← Back</button><button type="submit" class="btn btn--primary">Verify &amp; connect</button></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > credentials 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Sign in with Gradescope password</h2></header><div class="flex-1 overflow-y-auto min-h-0"><form><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-4.5">Sapling uses your password once, to sign in to Gradescope, and keeps only the session that sign-in creates, never the password. When that session expires, you'll enter your password again.</p><label for="X" class="mono block text-md text-text-muted mb-1.5">Email</label><input id="X" required="" autocomplete="username" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text text-base mb-3.5" type="email" value=""><label for="X" class="mono block text-md text-text-muted mb-1.5">Password</label><input id="X" required="" autocomplete="current-password" class="w-full py-2.5 px-3 rounded-sm border border-border bg-bg-input text-text text-base mb-5" type="password" value=""><div class="flex gap-2.5 justify-between items-center"><button type="button" class="btn btn--ghost py-1.5 px-2.5 text-sm">← Back</button><div class="flex gap-2.5"><button type="button" class="btn">Cancel</button><button type="submit" class="btn btn--primary">Connect</button></div></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the done stage for a clean sync > clean 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Sync complete</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-[15px] leading-[1.6] text-text mt-0 mx-0 mb-4.5">Pulled grades from Gradescope.</p><div class="grid grid-cols-[repeat(4,_1fr)] gap-3 mb-6"><div><div class="mono text-xs text-text-muted mb-1">Added</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text);">3</div></div><div><div class="mono text-xs text-text-muted mb-1">Updated</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text);">2</div></div><div><div class="mono text-xs text-text-muted mb-1">Skipped</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text-dim);">1</div></div><div><div class="mono text-xs text-text-muted mb-1">Failed</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text);">0</div></div></div><div class="flex gap-2.5 justify-end"><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the done stage for a partial sync > partial 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Sync needs attention</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-[15px] leading-[1.6] text-text mt-0 mx-0 mb-4.5">Some assignments could not be saved. Retry the sync to import the remaining grades.</p><div class="grid grid-cols-[repeat(4,_1fr)] gap-3 mb-6"><div><div class="mono text-xs text-text-muted mb-1">Added</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text);">1</div></div><div><div class="mono text-xs text-text-muted mb-1">Updated</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text);">0</div></div><div><div class="mono text-xs text-text-muted mb-1">Skipped</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--text-dim);">0</div></div><div><div class="mono text-xs text-text-muted mb-1">Failed</div><div class="font-display font-medium text-[28px] tracking-[-0.02em] leading-[1.1]" style="color: var(--err);">2</div></div></div><div class="flex gap-2.5 justify-end"><button type="button" class="btn btn--primary">Retry sync</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

