exports[`GradescopeSyncDialog stage DOM > renders the settings-mode connected stage (0) 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Gradescope is connected</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-3">Your Gradescope account is verified with 2 student courses. Go to a course in the gradebook to link it and sync grades.</p><p class="mono text-xs text-text-muted tracking-[-0.01em] mt-0 mx-0 mb-4.5">Last sync · DATE</p><div class="flex justify-between gap-3 flex-wrap"><button type="button" class="btn btn--ghost">Disconnect</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the settings-mode connected stage (1) 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Gradescope is connected</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-3">Your Gradescope account is verified with 1 student course. Go to a course in the gradebook to link it and sync grades.</p><p class="mono text-xs text-text-muted tracking-[-0.01em] mt-0 mx-0 mb-4.5">Last sync · DATE</p><div class="flex justify-between gap-3 flex-wrap"><button type="button" class="btn btn--ghost">Disconnect</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the settings-mode connected stage (2) 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · Connection</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Gradescope is connected</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-3">Sign-in was verified, but this account has no student courses. Check that you used the same Gradescope account you use for your classes.</p><div class="flex justify-between gap-3 flex-wrap"><button type="button" class="btn btn--ghost">Disconnect</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the verification-error stage and its Reconnect path 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · CS 101</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Couldn't verify Gradescope</h2></header><div role="alert" class="py-2.5 px-3 rounded-sm bg-err-soft text-err text-md mb-3.5 border border-[color-mix(in_oklab,_var(--err)_25%,_transparent)]">That's temporarily unavailable. Try again in a moment.</div><div class="flex-1 overflow-y-auto min-h-0"><div><p class="text-text-dim">Your saved credentials have not been changed. Retry the connection check, or reconnect if you want to use a different Gradescope session.</p><div class="flex flex-wrap gap-2.5"><button type="button" class="btn btn--primary">Retry connection</button><button type="button" class="btn">Reconnect</button><button type="button" class="btn">Cancel</button></div></div></div></div></div>"`;
