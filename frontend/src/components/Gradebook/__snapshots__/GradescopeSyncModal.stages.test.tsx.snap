exports[`GradescopeSyncDialog stage DOM > renders the settings-mode connected stage (0) 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Gradescope is connected</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 12px;">Your Gradescope account is verified with 2 student courses. Go to a course in the gradebook to link it and sync grades.</p><p class="mono" style="font-size: 11px; color: var(--text-muted); letter-spacing: -0.01em; margin: 0px 0px 18px;">Last sync · DATE</p><div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;"><button type="button" class="btn btn--ghost">Disconnect</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

