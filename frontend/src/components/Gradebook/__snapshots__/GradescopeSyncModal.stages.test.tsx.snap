// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GradescopeSyncDialog handlers > blocks dismissal while waiting for Duo, then reloads after approval 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Waiting for Duo approval</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div style="padding-top: 8px;"><div style="display: flex; gap: 14px; align-items: center; margin-bottom: 14px;"><div aria-hidden="true" style="width: 28px; height: 28px; border-radius: 50%; border-top-color: var(--accent); animation: gs-spin 0.9s linear infinite; flex-shrink: 0;"></div><div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 18px; color: var(--text); letter-spacing: -0.01em; margin-bottom: 2px;">Approve the Duo push on your phone.</div><div class="mono" style="font-size: 11px; color: var(--text-muted); letter-spacing: -0.01em;">Waiting · Ns</div></div></div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 13px; line-height: 1.6; color: var(--text-dim); margin: 0px;">Sapling is signing in at shib.bu.edu now. The push usually arrives within a few seconds. We'll finish automatically once you tap Approve. Keep this window open.</p></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > keeps the ready stage on a sync failure that is not a sign-in problem 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Pull grades from Gradescope</h2></header><div role="alert" style="padding: 10px 12px; border-radius: var(--r-sm); background: var(--err-soft); color: var(--err); font-size: 13px; margin-bottom: 14px; border: 1px solid color-mix(in oklab, var(--err) 25%, transparent);">Upstream down.</div><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 16px;">Sapling will pull every assignment from Gradescope course <span class="mono" style="color: var(--text);">123</span> and update grades in . New assignments are matched to categories by title where possible. You can re-categorize them after.</p><p class="mono" style="font-size: 11px; color: var(--text-muted); letter-spacing: -0.01em; margin: 0px 0px 18px;">Last sync · DATE</p><div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;"><button type="button" class="btn btn--ghost">Change course</button><button type="button" class="btn btn--ghost">Use different account</button><div style="display: flex; gap: 10px;"><button type="button" class="btn">Close</button><button type="button" class="btn btn--primary">Sync now</button></div></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > bu-sso-form 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Sign in with BU SSO</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><form><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 18px;">Enter your BU login. Sapling drives a headless browser through <span class="mono" style="color: var(--text);">shib.bu.edu</span> on your behalf. Your password is held in memory for the request only, never written to disk. When you submit, your phone will buzz with a Duo push; tap <strong style="color: var(--text);">Approve</strong>.</p><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">BU username</label><input id="X" required="" autocomplete="username" placeholder="e.g. jackhe" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-size: 14px; margin-bottom: 14px;" type="text" value=""><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">BU password</label><input id="X" required="" autocomplete="current-password" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-size: 14px; margin-bottom: 20px;" type="password" value=""><div style="display: flex; gap: 10px; justify-content: space-between; align-items: center;"><button type="button" class="btn btn--ghost" style="padding: 6px 10px; font-size: 12px;">← Back</button><button type="submit" class="btn btn--primary">Sign in &amp; send Duo push</button></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > choose-mode 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Connect Gradescope</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 18px;">Three ways to connect. Pick whichever matches how you sign in to Gradescope.</p><button type="button" style="width: 100%; text-align: left; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--bg-panel); cursor: pointer; transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);"><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 17px; color: var(--text); letter-spacing: -0.01em; margin-bottom: 4px;">BU SSO + Duo</div><div style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 13px; line-height: 1.5; color: var(--text-dim);">If you sign in to Gradescope through BU. Enter your BU username and password here; tap Approve when your phone buzzes. Your BU password is used in-memory only. Sapling never writes it to disk. Only the resulting Gradescope session cookies are stored.</div></button><div style="height: 12px;"></div><button type="button" style="width: 100%; text-align: left; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--bg-panel); cursor: pointer; transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);"><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 17px; color: var(--text); letter-spacing: -0.01em; margin-bottom: 4px;">Email + password</div><div style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 13px; line-height: 1.5; color: var(--text-dim);">If you set a Gradescope-side password (no SSO). We log in on your behalf each sync; password is encrypted at rest.</div></button><div style="height: 12px;"></div><button type="button" style="width: 100%; text-align: left; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--bg-panel); cursor: pointer; transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);"><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 17px; color: var(--text); letter-spacing: -0.01em; margin-bottom: 4px;">Session cookies (manual)</div><div style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 13px; line-height: 1.5; color: var(--text-dim);">If you'd rather paste session cookies yourself. Works for any school. Reconnect when the session expires or you sign out of Gradescope.</div></button><div style="display: flex; justify-content: flex-end; margin-top: 20px;"><button type="button" class="btn">Cancel</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > cookies 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Paste your Gradescope session</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><form><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 12px;">Sign in to Gradescope normally in another tab (BU SSO + Duo, whatever your school uses). Then copy these two cookie values out of DevTools.</p><ol style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 13px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 18px; padding-left: 20px;"><li>With Gradescope open, press <kbd style="display: inline-block; padding: 1px 6px; border-bottom-width: 2px; border-radius: 4px; font-family: var(--font-mono); font-size: 11px; background: var(--bg-subtle); color: var(--text);">F12</kbd> (or right-click → Inspect).</li><li>Go to <strong style="color: var(--text);">Application</strong> → <strong style="color: var(--text);">Cookies</strong> → <span class="mono" style="color: var(--text);">https://www.gradescope.com</span>.</li><li>Copy the <strong style="color: var(--text);">Value</strong> of <span class="mono">_gradescope_session</span> and, if present, <span class="mono">signed_token</span>.</li></ol><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">_gradescope_session <span style="color: var(--err);">*</span></label><textarea id="X" required="" rows="2" spellcheck="false" autocomplete="off" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-family: var(--font-mono); font-size: 12px; resize: vertical; margin-bottom: 14px;"></textarea><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">signed_token <span style="color: var(--text-muted);">(optional)</span></label><textarea id="X" rows="2" spellcheck="false" autocomplete="off" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-family: var(--font-mono); font-size: 12px; resize: vertical; margin-bottom: 20px;"></textarea><div style="display: flex; gap: 10px; justify-content: space-between; align-items: center;"><button type="button" class="btn btn--ghost" style="padding: 6px 10px; font-size: 12px;">← Back</button><button type="submit" class="btn btn--primary">Verify &amp; connect</button></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders each sign-in form with its title and Back returns to the choices > credentials 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Sign in with Gradescope password</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><form><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 18px;">Sapling will log into Gradescope on your behalf to pull your grades. Your password is encrypted at rest with AES-GCM and is never shown again after this form.</p><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Email</label><input id="X" required="" autocomplete="username" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-size: 14px; margin-bottom: 14px;" type="email" value=""><label for="X" class="mono" style="display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Password</label><input id="X" required="" autocomplete="current-password" style="width: 100%; padding: 10px 12px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-input); color: var(--text); font-size: 14px; margin-bottom: 20px;" type="password" value=""><div style="display: flex; gap: 10px; justify-content: space-between; align-items: center;"><button type="button" class="btn btn--ghost" style="padding: 6px 10px; font-size: 12px;">← Back</button><div style="display: flex; gap: 10px;"><button type="button" class="btn">Cancel</button><button type="submit" class="btn btn--primary">Connect</button></div></div></form></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the done stage for a clean sync > clean 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Sync complete</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 15px; line-height: 1.6; color: var(--text); margin: 0px 0px 18px;">Pulled grades from Gradescope.</p><div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px;"><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Added</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text); letter-spacing: -0.02em; line-height: 1.1;">3</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Updated</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text); letter-spacing: -0.02em; line-height: 1.1;">2</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Skipped</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text-dim); letter-spacing: -0.02em; line-height: 1.1;">1</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Failed</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text); letter-spacing: -0.02em; line-height: 1.1;">0</div></div></div><div style="display: flex; gap: 10px; justify-content: flex-end;"><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the done stage for a partial sync > partial 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Sync needs attention</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 15px; line-height: 1.6; color: var(--text); margin: 0px 0px 18px;">Some assignments could not be saved. Retry the sync to import the remaining grades.</p><div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px;"><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Added</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text); letter-spacing: -0.02em; line-height: 1.1;">1</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Updated</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text); letter-spacing: -0.02em; line-height: 1.1;">0</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Skipped</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--text-dim); letter-spacing: -0.02em; line-height: 1.1;">0</div></div><div><div class="mono" style="font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Failed</div><div style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 28px; color: var(--err); letter-spacing: -0.02em; line-height: 1.1;">2</div></div></div><div style="display: flex; gap: 10px; justify-content: flex-end;"><button type="button" class="btn btn--primary">Retry sync</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the empty link stage 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Pick the matching Gradescope course</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 16px;">Which Gradescope course should map to <span style="color: var(--text); font-weight: 500;"></span>?</p><p style="color: var(--text-dim); font-size: 14px;">We didn't find any student courses on this Gradescope account.</p><div style="display: flex; justify-content: flex-end; margin-top: 20px; gap: 10px;"><button type="button" class="btn">Cancel</button><button type="button" class="btn btn--ghost">Use different account</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the link stage with course rows and picks a course 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · CS 101</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Pick the matching Gradescope course</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 16px;">Which Gradescope course should map to <span style="color: var(--text); font-weight: 500;">CS 101</span>?</p><ul style="list-style: none; padding: 0px; margin: 0px;"><li style="margin-bottom: 6px;"><button type="button" style="width: 100%; text-align: left; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--bg-panel); cursor: pointer; color: var(--text); font-size: 14px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; transition: border-color var(--dur-fast) var(--ease);"><span><span style="font-weight: 500;">CS101</span><span style="color: var(--text-dim); margin-left: 8px;">Intro to CS</span></span><span class="mono" style="font-size: 11px; color: var(--text-muted);">Fall 2025</span></button></li><li style="margin-bottom: 6px;"><button type="button" style="width: 100%; text-align: left; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--bg-panel); cursor: pointer; color: var(--text); font-size: 14px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; transition: border-color var(--dur-fast) var(--ease);"><span><span style="font-weight: 500;">MA201</span></span><span class="mono" style="font-size: 11px; color: var(--text-muted);">2026</span></button></li></ul><div style="display: flex; justify-content: flex-end; margin-top: 20px; gap: 10px;"><button type="button" class="btn">Cancel</button><button type="button" class="btn btn--ghost">Use different account</button></div></div></div></div></div>"`;

