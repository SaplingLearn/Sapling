exports[`GradescopeSyncDialog stage DOM > renders the ready stage with the last sync and the syncing stage > ready 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" class="fixed inset-0 bg-[rgba(15,_17,_16,_0.55)] flex items-center justify-center z-100 p-4"><div class="bg-bg-panel rounded-lg py-7 px-8 w-[min(560px,_100%)] max-h-[min(640px,_90vh)] flex flex-col shadow-lg"><header class="mb-4.5"><div class="mono text-sm text-text-muted mb-2">Gradescope · CS 101</div><h2 id="X" class="font-display font-medium text-[24px] tracking-[-0.01em] text-text m-0">Pull grades from Gradescope</h2></header><div class="flex-1 overflow-y-auto min-h-0"><div><p class="font-serif text-base leading-[1.6] text-text-dim mt-0 mx-0 mb-4">Sapling will pull every assignment from Gradescope course <span class="mono text-text">123</span> and update grades in CS 101. New assignments are matched to categories by title where possible. You can re-categorize them after.</p><p class="mono text-xs text-text-muted tracking-[-0.01em] mt-0 mx-0 mb-4.5">Last sync · DATE</p><div class="flex justify-between gap-3 flex-wrap"><button type="button" class="btn btn--ghost">Change course</button><button type="button" class="btn btn--ghost">Use different account</button><div class="flex gap-2.5"><button type="button" class="btn">Close</button><button type="button" class="btn btn--primary">Sync now</button></div></div></div></div></div></div>"`;

