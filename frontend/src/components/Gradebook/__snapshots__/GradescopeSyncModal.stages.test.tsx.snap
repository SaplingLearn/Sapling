exports[`GradescopeSyncDialog stage DOM > renders the settings-mode connected stage (2) 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · Connection</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Gradescope is connected</h2></header><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="font-family: var(--font-serif), var(--font-aleo), 'Aleo', Georgia, serif; font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0px 0px 12px;">Sign-in was verified, but this account has no student courses. Check that you used the same Gradescope account you use for your classes.</p><div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;"><button type="button" class="btn btn--ghost">Disconnect</button><button type="button" class="btn btn--primary">Done</button></div></div></div></div></div>"`;

exports[`GradescopeSyncDialog stage DOM > renders the verification-error stage and its Reconnect path 1`] = `"<div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gs-modal-title" style="position: fixed; inset: 0px; background: rgba(15, 17, 16, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 16px;"><div style="background: var(--bg-panel); border-radius: var(--r-lg); padding: 28px 32px; max-height: min(640px, 90vh); display: flex; flex-direction: column; box-shadow: var(--shadow-lg);"><header style="margin-bottom: 18px;"><div class="mono" style="font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Gradescope · CS 101</div><h2 id="X" style="font-family: var(--font-display), 'Aleo', Georgia, serif; font-weight: 500; font-size: 24px; letter-spacing: -0.01em; color: var(--text); margin: 0px;">Couldn't verify Gradescope</h2></header><div role="alert" style="padding: 10px 12px; border-radius: var(--r-sm); background: var(--err-soft); color: var(--err); font-size: 13px; margin-bottom: 14px; border: 1px solid color-mix(in oklab, var(--err) 25%, transparent);">That's temporarily unavailable. Try again in a moment.</div><div style="flex: 1 1 0%; overflow-y: auto; min-height: 0px;"><div><p style="color: var(--text-dim);">Your saved credentials have not been changed. Retry the connection check, or reconnect if you want to use a different Gradescope session.</p><div style="display: flex; flex-wrap: wrap; gap: 10px;"><button type="button" class="btn btn--primary">Retry connection</button><button type="button" class="btn">Reconnect</button><button type="button" class="btn">Cancel</button></div></div></div></div></div>"`;
