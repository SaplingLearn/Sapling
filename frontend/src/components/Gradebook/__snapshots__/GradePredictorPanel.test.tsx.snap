exports[`AssignmentSliderRow — DOM snapshot > curved, no stored total, with hyp 1`] = `"<div style="margin-bottom: var(--pad-xl);"><button type="button" style="display: flex; align-items: center; gap: 8px; width: 100%; padding: 10px 0px; background: none; border-top: 1px solid var(--border); border-right: 0px; border-bottom: medium; border-left: 0px; border-image: none; cursor: pointer; text-align: left; font-family: var(--font-sans);"><span style="display: inline-block; transition: transform 0.2s; transform: rotate(0deg); color: var(--accent); font-size: 13px;">▾</span><span style="font-size: 13px; font-weight: 500; color: var(--accent);">Predict My Grade</span><span style="font-size: 11px; color: var(--text-dim);">Set hypothetical scores for 1 ungraded assignment</span></button><div style="background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--r-md); padding: var(--pad-md) var(--pad-lg); margin-top: 8px;"><div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><div style="display: flex; align-items: center; gap: 10px;"><span class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted);">Hypothetical Scores</span><div style="display: flex; background: var(--bg); border-radius: 20px; padding: 2px; border: 1px solid var(--border);"><button type="button" style="padding: 3px 10px; border-radius: 18px; font-size: 10px; font-weight: 500; background: transparent; color: var(--text-dim); border: 0px; cursor: pointer; font-family: var(--font-sans);">Raw</button><button type="button" style="padding: 3px 10px; border-radius: 18px; font-size: 10px; font-weight: 500; background: var(--accent); color: rgb(255, 255, 255); border: 0px; cursor: default; font-family: var(--font-sans);">Curved</button></div></div><button type="button" class="btn" style="padding: 4px 12px; font-size: 12px; background: rgb(255, 255, 255);">Reset All</button></div><div style="display: flex; flex-direction: column; gap: 2px;"><div style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(160px, 220px) auto; gap: 12px; align-items: center; padding: 10px 0px; border-bottom: 1px solid var(--border);"><div style="min-width: 0px;"><div style="font-family: var(--font-serif); font-size: 13px; font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Problem Set 3</div><div class="mono" style="font-size: 11px; color: var(--text-dim); margin-top: 2px;">Homework · Due 03/07/2026</div></div><div style="display: flex; flex-direction: column; gap: 3px;"><input min="0" max="8" step="any" style="width: 100%; accent-color: var(--accent);" type="range" value="3"><div class="mono" style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted);"><span>0</span><span>8 pts</span></div></div><div style="display: flex; align-items: center; gap: 4px; white-space: nowrap;"><input min="0" step="any" style="width: 52px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 6px; text-align: right; font-size: 13px; font-family: var(--font-mono);" type="number" value="3"><span style="color: var(--text-muted); font-size: 12px;">/</span><input min="1" step="any" placeholder="—" style="width: 46px; padding: 4px 6px; border: 1px dashed var(--border); border-radius: 6px; text-align: right; font-size: 12px; font-family: var(--font-mono); background: var(--bg);" type="number" value="8"></div><div style="grid-column: 1 / -1; display: flex; gap: 8px; align-items: center; margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--border);"><span class="mono" style="font-size: 10px; color: var(--text-muted); white-space: nowrap;">Bell Curve:</span><label style="display: flex; align-items: center; gap: 4px; font-size: 11px;"><span style="color: var(--text-dim);">Class Avg</span><input min="0" max="100" step="any" placeholder="70" style="width: 44px; padding: 2px 4px; border: 1px solid var(--accent-border); border-radius: 4px; text-align: right; font-size: 11px; font-family: var(--font-mono); background: var(--accent-soft);" type="number" value=""><span style="color: var(--text-muted);">%</span></label><label style="display: flex; align-items: center; gap: 4px; font-size: 11px;"><span style="color: var(--text-dim);">SD</span><input min="0" max="100" step="any" placeholder="—" style="width: 44px; padding: 2px 4px; border: 1px solid var(--accent-border); border-radius: 4px; text-align: right; font-size: 11px; font-family: var(--font-mono); background: var(--accent-soft);" type="number" value="20"><span style="color: var(--text-muted);">%</span></label><span class="mono" style="font-size: 10px; color: var(--accent); margin-left: 2px;">✓ Curve Active</span></div></div></div><p style="font-size: 11px; color: var(--text-muted); margin-top: 14px; margin-bottom: 0px;">Scores shown are hypothetical only. Nothing is saved until you enter grades above.</p></div></div>"`;

exports[`AssignmentSliderRow — DOM snapshot > raw, stored total, no hyp 1`] = `"<div style="margin-bottom: var(--pad-xl);"><button type="button" style="display: flex; align-items: center; gap: 8px; width: 100%; padding: 10px 0px; background: none; border-top: 1px solid var(--border); border-right: 0px; border-bottom: medium; border-left: 0px; border-image: none; cursor: pointer; text-align: left; font-family: var(--font-sans);"><span style="display: inline-block; transition: transform 0.2s; transform: rotate(0deg); color: var(--accent); font-size: 13px;">▾</span><span style="font-size: 13px; font-weight: 500; color: var(--accent);">Predict My Grade</span><span style="font-size: 11px; color: var(--text-dim);">Set hypothetical scores for 1 ungraded assignment</span></button><div style="background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--r-md); padding: var(--pad-md) var(--pad-lg); margin-top: 8px;"><div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><div style="display: flex; align-items: center; gap: 10px;"><span class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted);">Hypothetical Scores</span></div><button type="button" class="btn" style="padding: 4px 12px; font-size: 12px; background: rgb(255, 255, 255);">Reset All</button></div><div style="display: flex; flex-direction: column; gap: 2px;"><div style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(160px, 220px) auto; gap: 12px; align-items: center; padding: 10px 0px; border-bottom: 1px solid var(--border);"><div style="min-width: 0px;"><div style="font-family: var(--font-serif); font-size: 13px; font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Problem Set 3</div><div class="mono" style="font-size: 11px; color: var(--text-dim); margin-top: 2px;">Homework · Due 03/07/2026</div></div><div style="display: flex; flex-direction: column; gap: 3px;"><input min="0" max="40" step="any" style="width: 100%; accent-color: var(--accent);" type="range" value="20"><div class="mono" style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted);"><span>0</span><span>40 pts</span></div></div><div style="display: flex; align-items: center; gap: 4px; white-space: nowrap;"><input min="0" step="any" style="width: 52px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 6px; text-align: right; font-size: 13px; font-family: var(--font-mono);" type="number" value="20"><span style="color: var(--text-muted); font-size: 12px;">/</span><span class="mono" style="font-size: 13px; color: var(--text-muted); min-width: 32px;">40</span></div></div></div><p style="font-size: 11px; color: var(--text-muted); margin-top: 14px; margin-bottom: 0px;">Scores shown are hypothetical only. Nothing is saved until you enter grades above.</p></div></div>"`;
