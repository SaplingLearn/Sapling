exports[`AssignmentSliderRow — DOM snapshot > curved, no stored total, with hyp 1`] = `"<div class="mb-(--pad-xl)"><button type="button" class="flex items-center gap-2 w-full py-2.5 px-0 [background:none] border-0 border-t border-t-border cursor-pointer text-left font-sans border-b-0"><span class="inline-block [transition:transform_0.2s] text-accent text-md [transform:rotate(0deg)]">▾</span><span class="text-md font-medium text-accent">Predict My Grade</span><span class="text-xs text-text-dim">Set hypothetical scores for 1 ungraded assignment</span></button><div class="bg-bg-subtle border border-border rounded-md py-(--pad-md) px-(--pad-lg) mt-2"><div class="flex items-center justify-between mb-4 pb-3 border-b border-b-border"><div class="flex items-center gap-2.5"><span class="mono text-sm text-text-muted">Hypothetical Scores</span><div class="flex bg-bg rounded-[20px] p-0.5 border border-border"><button type="button" class="py-[3px] px-2.5 rounded-[18px] text-2xs font-medium border-0 font-sans bg-transparent text-text-dim cursor-pointer">Raw</button><button type="button" class="py-[3px] px-2.5 rounded-[18px] text-2xs font-medium border-0 font-sans bg-accent text-accent-fg cursor-default">Curved</button></div></div><button type="button" class="btn py-1 px-3 text-sm bg-accent-fg">Reset All</button></div><div class="flex flex-col gap-0.5"><div class="grid grid-cols-[minmax(0,_1fr)_minmax(160px,_220px)_auto] gap-3 items-center py-2.5 px-0 border-b border-b-border"><div class="min-w-0"><div class="font-serif text-md font-medium text-text overflow-hidden text-ellipsis whitespace-nowrap">Problem Set 3</div><div class="mono text-xs text-text-dim mt-0.5">Homework · Due 03/07/2026</div></div><div class="flex flex-col gap-[3px]"><input min="0" max="8" step="any" class="w-full accent-accent" type="range" value="3"><div class="mono flex justify-between text-[9px] text-text-muted"><span>0</span><span>8 pts</span></div></div><div class="flex items-center gap-1 whitespace-nowrap"><input min="0" step="any" class="w-13 py-1 px-1.5 border border-border rounded-sm text-right text-md font-sans" type="number" value="3"><span class="text-text-muted text-sm">/</span><input min="1" step="any" placeholder="—" class="w-11.5 py-1 px-1.5 border border-dashed border-border rounded-sm text-right text-sm font-sans bg-bg" type="number" value="8"></div><div class="[grid-column:1_/_-1] flex gap-2 items-center mt-1.5 pt-1.5 [border-top:1px_dashed_var(--border)]"><span class="mono text-2xs text-text-muted whitespace-nowrap">Bell Curve:</span><label class="flex items-center gap-1 text-xs"><span class="text-text-dim">Class Avg</span><input min="0" max="100" step="any" placeholder="70" class="w-11 py-0.5 px-1 border border-accent-border rounded-xs text-right text-xs font-sans bg-accent-soft" type="number" value=""><span class="text-text-muted">%</span></label><label class="flex items-center gap-1 text-xs"><span class="text-text-dim">SD</span><input min="0" max="100" step="any" placeholder="—" class="w-11 py-0.5 px-1 border border-accent-border rounded-xs text-right text-xs font-sans bg-accent-soft" type="number" value="20"><span class="text-text-muted">%</span></label><span class="mono text-2xs text-accent ml-0.5">✓ Curve Active</span></div></div></div><p class="text-xs text-text-muted mt-3.5 mb-0">Scores shown are hypothetical only. Nothing is saved until you enter grades above.</p></div></div>"`;

