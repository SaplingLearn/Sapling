exports[`QuizHome — characterization: rendered DOM per state > an empty tree 1`] = `"<div class="quiz-home" data-testid="quiz-home"><div class="quiz-inset--home"><div class="quiz-col quiz-col--home"><div class="empty-state empty-state--md" data-testid="quiz-empty-state"><h2 class="empty-state__title h-serif">Your tree is empty</h2><p class="empty-state__body body-serif">Upload notes or talk to the tutor and concepts will appear here.</p><div class="empty-state__action"><a class="btn btn--primary" href="/library">Go to your library</a><a class="btn" href="/learn">Talk to the tutor</a></div></div></div></div></div>"`;

exports[`QuizHome — characterization: rendered DOM per state > an error 1`] = `"<div class="quiz-home" data-testid="quiz-home" style="--quiz-accent: #7b4b99;"><div class="quiz-inset--home"><div class="quiz-col quiz-col--home"><div class="quiz-error" role="alert" data-testid="quiz-home-error"><h2 class="h-serif quiz-error__title">We couldn't load your tree</h2><p class="quiz-error__body">You look offline.</p><div class="quiz-error__actions"><button type="button" class="btn btn--primary" data-testid="quiz-home-retry">Retry</button></div></div></div></div></div>"`;

