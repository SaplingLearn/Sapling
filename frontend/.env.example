# Backend URL consumed by client fetches. Leave empty in production so
# calls resolve as same-origin /api/... paths, which Next.js rewrites
# to BACKEND_URL server-side. Only set this if the frontend runs on a
# different origin than the proxy and CORS is configured on the backend.
NEXT_PUBLIC_API_URL=

# Backend URL for the Next.js rewrite (/api/:path* -> ${BACKEND_URL}/api/:path*).
# Required in production. Locally this defaults to http://localhost:5000.
BACKEND_URL=http://localhost:5000

# HMAC secret (min 32 bytes). Must match backend SESSION_SECRET.
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-string

# Supabase (for realtime chat in /social rooms).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Product analytics (PostHog, US region). The project key (phc_...) is public
# by design, but NEXT_PUBLIC_* values are inlined at BUILD time. On Cloudflare,
# set NEXT_PUBLIC_POSTHOG_KEY as a Workers Builds BUILD variable on each worker
# (`frontend` = prod, `frontend-staging` = staging): Workers & Pages → <worker>
# → Settings → Build → Variables and secrets. wrangler.toml [vars] are
# runtime-only and too late. Unset or empty = analytics fully off (posthog-js
# is never loaded). NEXT_PUBLIC_TEST_MODE / NEXT_PUBLIC_LOCAL_MODE builds stay
# off even with a key. See src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional api_host override: a SAME-ORIGIN path only ("/something"); any
# absolute or external value is ignored and /ingest is used, so a build var
# can never route events around the proxy. Leave EMPTY to use the /ingest
# proxy (src/app/ingest/[...path]/route.ts), which verifies the session,
# checks the project key and strips cookies before forwarding.
NEXT_PUBLIC_POSTHOG_HOST=
