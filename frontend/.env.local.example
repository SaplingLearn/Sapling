# ── Turnkey LOCAL dev env for the Sapling frontend ──
# Copy to frontend/.env.local:   cp .env.local.example .env.local
# All values are LOCAL-ONLY and safe to commit.

# Same-origin API — leave EMPTY (a cross-origin value drops the session cookie → 401).
NEXT_PUBLIC_API_URL=

# Server-side origin for the Next.js /api/* rewrite + middleware session check.
BACKEND_URL=http://localhost:5000

# MUST equal backend SESSION_SECRET (the fixed local default).
SESSION_SECRET=sapling-local-dev-session-secret-change-only-if-you-know-why

# Local Supabase (for /social realtime chat only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
