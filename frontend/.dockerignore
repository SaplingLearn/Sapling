# Keep the build context small and avoid clobbering the image's installed
# node_modules / build output with local copies (#173).
node_modules
.next
.open-next
.wrangler
.turbo
npm-debug.log*
.env*
# Cloudflare local secrets (wrangler `.dev.vars`). Not copied into the runner
# stage today, but keep it out of the build context entirely — defense in depth.
.dev.vars
.dev.vars.*
.git
.gitignore
Dockerfile
.dockerignore
coverage
*.local
.DS_Store
